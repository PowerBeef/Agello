{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillOverrides": {
    "swift-mlx": "off",
    "swift-mlx-lm": "off"
  },
  "permissions": {
    "additionalDirectories": ["../LiteRT-LM"],
    "deny": [
      "Skill(asc:asc-shots-pipeline)",
      "Skill(asc:asc-notarization)",
      "mcp__Claude_Code_iOS_Simulator",
      "Agent(axiom:simulator-tester)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-target-edits.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
