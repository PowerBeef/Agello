<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The 2.6–3.7 GB model files are memory-mapped; without a larger
	     address space, re-creating an engine can fail to map sections
	     ("Cannot allocate memory") and LiteRT-LM silently loads a broken model. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<!-- Default per-app memory limit measured on device: ~3.5 GB. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Replies keep running (on the GPU) when the user leaves the app,
	     as continued processing tasks, where the device supports it. -->
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
	<!-- Shared with the share extension: items shared from other apps. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.patricedery.irtchat</string>
	</array>
</dict>
</plist>
